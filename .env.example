# Required
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional hardening / tuning
# SUPABASE_READ_ONLY=true            # disables insert_record
# SUPABASE_ALLOWED_TABLES=usage_logs,memories   # restrict query_table / insert_record / list_tables
# SUPABASE_MAX_ROWS=1000             # cap for query_table limit
# SUPABASE_TIMEOUT_MS=15000          # per-request timeout
